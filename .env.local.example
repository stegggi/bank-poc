

NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=<YOUR_ARBITRUM_SEPOLIA_RPC_URL>

NEXT_PUBLIC_PRIVY_APP_ID=<YOUR_PRIVY_APP_ID>

BICONOMY_BUNDLER_URL=<YOUR_BICONOMY_BUNDLER_URL>
BICONOMY_PAYMASTER_KEY=<YOUR_BICONOMY_PAYMASTER_KEY>  # secret

REGISTRY_ADDRESS=<FILLED_AFTER_DEPLOY>
FACILITATOR_ADDRESS=<FILLED_AFTER_DEPLOY>
DEMO_TOKEN_ADDRESS=<FILLED_AFTER_DEPLOY>

NEXT_PUBLIC_OWNER_ADDRESS=0xB773494a1C7cbfB3266b958e07fe367a98Cc8203

# UC6 (Vercel/server-side)
UC6_BOT_BASE_URL=http://35.205.209.20:8797
UC6_BOT_ADMIN_TOKEN=<UC6_ADMIN_TOKEN_FROM_VM>
UC6_OWNER_ADDRESS=<UC6_OWNER_WALLET>
NEXT_PUBLIC_UC6_OWNER_ADDRESS=<UC6_OWNER_WALLET>

# UC7 — wallet ownership signing via WalletConnect (mobile / hardware wallets).
# Free project id: https://cloud.reown.com (formerly cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# UC7 — Source of Wealth
# Etherscan V2 (single key covers Ethereum, Base, Arbitrum, Polygon, BSC, Optimism).
# Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=<ETHERSCAN_V2_API_KEY>
# Optional: Helius for Solana (falls back to public RPC if unset)
HELIUS_API_KEY=
# Optional: CoinGecko Demo API key (raises rate limit from ~10/min to 30/min).
# Get a free key at https://www.coingecko.com/en/api/pricing — choose the Demo plan.
COINGECKO_API_KEY=
# Optional: forensic provider (mock | chainalysis | elliptic)
TTP_PROVIDER=mock
# Optional: hop depth for backward trace (default 3)
MAX_HOP_DEPTH=3

# UC8 — Tempo Testnet (Moderato), chain ID 42431. Stablecoin-payments L1, no native gas token.
# Throwaway dev wallet — generate with: node scripts/tempo-keygen.mjs
# Writes these into .env.local (gitignored). The key must be FRESH/throwaway — never a real key.
TEMPO_DEV_PRIVATE_KEY=<GENERATED_BY_scripts/tempo-keygen.mjs>  # secret
TEMPO_DEV_ADDRESS=<GENERATED_BY_scripts/tempo-keygen.mjs>
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# UC8 task 2 — TIP-20 factory + TIP-403 policy. All generated/recorded by
# scripts/tempo-factory-policy.mjs (into .env.local, gitignored). Throwaway parties.
TEMPO_PARTY_B_PRIVATE_KEY=<GENERATED>  # secret — allowlisted recipient "B"
TEMPO_PARTY_B_ADDRESS=<GENERATED>
TEMPO_PARTY_C_PRIVATE_KEY=<GENERATED>  # secret — non-allowlisted address "C"
TEMPO_PARTY_C_ADDRESS=<GENERATED>
TEMPO_MUSDC_ADDRESS=<FILLED_AFTER_FACTORY_CREATE>  # mUSDC TIP-20 token address
TEMPO_POLICY_ID=<FILLED_AFTER_POLICY_CREATE>       # TIP-403 allowlist policy id

# UC8 task 3 / step 5 — Act 2 tokenized deposit (tCHF) + 4 sub-accounts. All generated/recorded
# by scripts/tempo-act2-setup.mjs (into .env.local, gitignored). Throwaway sub-account wallets.
TEMPO_TCHF_ADDRESS=<FILLED_AFTER_FACTORY_CREATE>   # tCHF TIP-20 (currency CHF)
TEMPO_SUB_HQ_PRIVATE_KEY=<GENERATED>  # secret — HQ Treasury sub-account
TEMPO_SUB_HQ_ADDRESS=<GENERATED>
TEMPO_SUB_FRA_PRIVATE_KEY=<GENERATED>  # secret — Frankfurt sub-account
TEMPO_SUB_FRA_ADDRESS=<GENERATED>
TEMPO_SUB_NYC_PRIVATE_KEY=<GENERATED>  # secret — New York sub-account
TEMPO_SUB_NYC_ADDRESS=<GENERATED>
TEMPO_SUB_LAG_PRIVATE_KEY=<GENERATED>  # secret — Lagos sub-account
TEMPO_SUB_LAG_ADDRESS=<GENERATED>
