[Unit]
Description=UC5 Ethereal Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stefan_geisler
WorkingDirectory=/home/stefan_geisler/bank-poc/use-cases/uc5-perp-trading/bot
EnvironmentFile=/home/stefan_geisler/bank-poc/use-cases/uc5-perp-trading/bot/.env
ExecStart=/home/stefan_geisler/bank-poc/use-cases/uc5-perp-trading/bot/.venv/bin/python /home/stefan_geisler/bank-poc/use-cases/uc5-perp-trading/bot/uc5-bot.py
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=append:/home/stefan_geisler/uc5-bot.log
StandardError=append:/home/stefan_geisler/uc5-bot.log

[Install]
WantedBy=multi-user.target
